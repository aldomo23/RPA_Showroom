---
import Icon from "./Icon.astro";
import { hero, site } from "../data/site";
---

<section id="inicio" class="relative isolate overflow-hidden bg-vino pt-[4.5rem] text-crema" aria-labelledby="hero-titulo">
  <!-- Arcos de línea fina decorativos -->
  <svg
    class="pointer-events-none absolute top-1/2 -right-40 -z-10 h-[46rem] w-[46rem] -translate-y-1/2 text-rosa opacity-25 sm:-right-24 lg:right-[-6rem]"
    viewBox="0 0 400 400"
    fill="none"
    aria-hidden="true"
  >
    <circle cx="200" cy="200" r="199" stroke="currentColor" stroke-width="0.6" />
    <circle cx="200" cy="200" r="150" stroke="currentColor" stroke-width="0.6" />
    <path d="M200 1v398M1 200h398" stroke="currentColor" stroke-width="0.4" stroke-dasharray="2 6" />
  </svg>

  <div class="container-zeya flex min-h-[calc(100svh-4.5rem)] flex-col justify-center py-20 sm:py-28">
    <div class="max-w-3xl">
      <p class="eyebrow text-rosa">{hero.eyebrow}</p>
      <h1
        id="hero-titulo"
        class="mt-6 text-[2.9rem] leading-[1.02] text-hueso sm:text-7xl lg:text-[5.5rem]"
      >
        {hero.title}
      </h1>
      <p class="mt-7 max-w-xl text-lg font-light text-crema sm:text-xl">
        {hero.subtitle}
      </p>
      <div class="mt-10 flex flex-col gap-3 sm:flex-row sm:items-center sm:gap-4">
        <a href={site.whatsapp.general} target="_blank" rel="noopener" class="btn btn-crema">
          <Icon name="whatsapp" size={18} />
          {hero.primaryCta}
          <span class="sr-only">(abre WhatsApp en una pestaña nueva)</span>
        </a>
        <a href="#tratamientos" class="btn btn-outline-crema">
          {hero.secondaryCta}
          <Icon name="arrow" size={18} />
        </a>
      </div>
    </div>
  </div>
</section>
