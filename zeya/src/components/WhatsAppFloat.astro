---
import Icon from "./Icon.astro";
import { site } from "../data/site";
---

<a
  href={site.whatsapp.general}
  target="_blank"
  rel="noopener"
  class="fixed right-4 bottom-4 z-40 inline-flex size-14 items-center justify-center rounded-full bg-whatsapp text-white shadow-[0_8px_24px_-6px_rgb(0_0_0/0.45)] ring-2 ring-hueso/80 transition-transform duration-200 hover:scale-105 focus-visible:outline-offset-4 sm:right-6 sm:bottom-6"
  aria-label="Escríbenos por WhatsApp (abre en una pestaña nueva)"
>
  <Icon name="whatsapp" size={28} />
</a>
